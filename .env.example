# Future production server config. The static prototype does not read these.
NODE_ENV=development
DATABASE_URL=postgresql://APP_USER:REPLACE_ME@localhost:5432/content_studio
REDIS_URL=redis://localhost:6379
APP_TIMEZONE=Asia/Ho_Chi_Minh
OPENAI_API_KEY=REPLACE_WITH_SERVER_SECRET
OPENAI_TEXT_MODEL=CONFIGURE_VERIFIED_MODEL
OPENAI_IMAGE_MODEL=gpt-image-1
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=5
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_WITH_SERVER_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8080/api/oauth/google/callback
META_APP_ID=REPLACE_ME
META_APP_SECRET=REPLACE_WITH_SERVER_SECRET
META_GRAPH_VERSION=CONFIGURE_VERIFIED_VERSION
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_SERVER_SECRET
OBJECT_STORAGE_ENDPOINT=CONFIGURE_ENDPOINT
OBJECT_STORAGE_BUCKET=content-studio
OBJECT_STORAGE_ACCESS_KEY=REPLACE_WITH_SERVER_SECRET
OBJECT_STORAGE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET
AUTH_SECRET=REPLACE_WITH_SERVER_SECRET
# OAuth refresh/Page tokens belong in encrypted per-connection records, not here.
