{
  "name": "hbg-content-studio-phase1",
  "version": "1.3.2",
  "type": "module",
  "description": "The HBG Content Studio - Phase 1 Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg",
    "build:mac:arm64": "electron-builder --mac dmg --arm64",
    "build:mac:x64": "electron-builder --mac dmg --x64",
    "build:mac:universal": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "lucide": "^1.64.0"
  },
  "build": {
    "appId": "vn.hoabinhgroup.contentstudio",
    "productName": "HBG Content Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "server.js",
      "src/**/*",
      "dist/**/*",
      "electron/**/*",
      "package.json",
      ".env.example"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "simplebar": "^6.3.3"
  }
}